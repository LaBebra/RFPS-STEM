flowchart TD
    Z((А)) --> J[Запуск набору<br/>або всіх тестів]
    J --> K[Live-прогрес прогону]
    K --> L{Є невдалі<br/>тести?}
    L -- Так --> M[Аналіз помилки<br/>та консолі]
    M --> N{Причина<br/>в тесті?}
    N -- Так --> F[[Повернення до кроку<br/>«Новий тест-кейс»]]
    N -- Ні --> O[Виправлення коду,<br/>перезапуск невдалих]
    O --> K
    L -- Ні --> P[Експорт звіту<br/>HTML / CSV / JSON]
    P --> Q([Звіт про якість<br/>отримано])
