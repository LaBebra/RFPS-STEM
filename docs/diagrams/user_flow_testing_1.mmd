flowchart TD
    A([Дашборд]) --> B[Розділ «Тестові набори»]
    B --> C{Потрібний набір<br/>існує?}
    C -- Ні --> D[Створення набору:<br/>назва, теги,<br/>код підготовки] --> E
    C -- Так --> E[Сторінка набору]
    E --> F[Новий тест-кейс:<br/>назва, пріоритет,<br/>код з expect]
    F --> G[Пробний запуск<br/>у Web Worker]
    G --> H{Результат<br/>очікуваний?}
    H -- Ні --> F
    H -- Так --> I[Збереження<br/>тест-кейсу]
    I --> Z((А))
